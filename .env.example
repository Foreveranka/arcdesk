# Copy to .env and fill in. NEVER commit the real .env — it wires the keeper to live funds.
#
# The escrow is symmetric: the same contract is deployed to both chains and the chain decides
# which half is used. "SOURCE" is where takers pay (Base); "ARC" is where maker liquidity sits.

# ---- source chain (Base) ----
SOURCE_RPC=https://mainnet.base.org
SOURCE_RPC_2=                                              # optional failover endpoint
SOURCE_CHAIN_ID=8453
SOURCE_USDC=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913     # Base mainnet USDC
SOURCE_ESCROW=                                             # ArcdeskEscrow on Base

# ---- Arc ----
# Arc's gas token IS USDC: balanceOf is the account's native balance / 1e12.
ARC_RPC=https://rpc.arc-scan.org
ARC_RPC_2=https://arc-mainnet-rpc.baracat.meme             # failover; Arc RPCs return 503 often
ARC_CHAIN_ID=5042
ARC_USDC=0x3600000000000000000000000000000000000000        # Arc USDC predeploy
ARC_ESCROW=                                                # ArcdeskEscrow on Arc

# ---- desk ----
# The keeper may only reserve liquidity; it can never move funds or change roles. Keep just
# enough gas on it and nothing more, since this key lives on the server.
KEEPER_PK=0x...
TREASURY=0x...                                             # receives the desk fee
FEE_BPS=200                                                # 2%

# Testnet values, for reference:
#   SOURCE_RPC=https://sepolia.base.org        SOURCE_CHAIN_ID=84532
#   SOURCE_USDC=0x036CbD53842c5426634e7929541eC2318f3dCF7e
#   ARC_RPC=https://rpc.testnet.arc.network    ARC_CHAIN_ID=5042002
